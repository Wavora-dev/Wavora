<?xml version="1.0" encoding="utf-8"?>
<!--
    Banner placeholder para el launcher de Android TV (320x180dp, la medida que
    exige Google). Es funcional (cumple el requisito para que la app se pueda
    instalar y aparezca en el launcher) pero es solo un placeholder: fondo
    oscuro + tu ícono real centrado. Reemplazalo cuando tengas un banner de
    marca hecho a medida (ideal: una imagen horizontal con el logo, no el
    ícono cuadrado estirado).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/app_icon" />
</layer-list>
